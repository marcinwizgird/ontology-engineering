    rr:predicateObjectMap [ rr:predicate ex-fibo:issuedBy ; rr:objectMap [ rr:template "https://example.org/fibo-vkg/data/company/{\"ISSUER_COMP_ID\"}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ex-fibo:listedOn ; rr:objectMap [ rr:template "https://example.org/fibo-vkg/data/exchange/{\"EXCH_ID\"}" ] ] .

