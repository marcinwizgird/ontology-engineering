<https://example.org/fiben/shapes#AccountsPayableAndAccruedLiabilities> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path fiben:hasName ] ;
    sh:targetClass fiben:AccountsPayableAndAccruedLiabilities .

