# CQ: Through which account was a securities transaction made?
# Authored from the banking scope (PLAN.md), not from FIBEN's gold questions.
PREFIX fiben: <https://example.org/fiben/voc#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { ?p rdfs:domain fiben:SecuritiesTransaction ; rdfs:range fiben:FinancialServiceAccount }
