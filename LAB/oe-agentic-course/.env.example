# Copy to .env (same folder) and fill in. agentlab/llm.py reads it on import;
# variables already set in your shell win. Never commit .env.
#
#   cp .env.example .env          (bash)
#   Copy-Item .env.example .env   (PowerShell)

# Required: the notebooks that use a model call the live Anthropic API.
ANTHROPIC_API_KEY=

# Optional (defaults shown).
# OE_COURSE_DSPY_MODEL=anthropic/claude-sonnet-5-5
# OE_COURSE_REFLECTION_MODEL=anthropic/claude-opus-5-5
# OE_COURSE_MAX_TOKENS=16000
