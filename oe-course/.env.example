# Copy to .env (same folder) and fill in. Loaded by oe_course.config on import;
# variables already set in your shell take precedence. Never commit .env.
#
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)

# Required: every problem set calls the live Anthropic API.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# OE_COURSE_MODEL=claude-opus-5
# OE_COURSE_REFLECTION_MODEL=anthropic/claude-opus-5
# OE_COURSE_MAX_TOKENS=16000
# OE_COURSE_FUSEKI_URL=http://localhost:3030
