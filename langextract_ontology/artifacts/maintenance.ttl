<https://example.org/onto> a owl:Ontology ;
    dcterms:source <https://example.org/onto/source/maintenance-notes> ;
    prov:wasGeneratedBy "langextract/simulated-ontology-extractor" .

:BoilerFeedPump a owl:Class ;
    rdfs:label "boiler feed pump" ;
    rdfs:subClassOf :CentrifugalPump .

:Compressor a owl:Class ;
    rdfs:label "compressor" ;
    rdfs:subClassOf :RotatingEquipment .

:Impeller a owl:Class ;
    rdfs:label "impeller" .

:P-101 a owl:NamedIndividual,
        :CentrifugalPump ;
    rdfs:label "P-101" .

:SlurryPump a owl:Class ;
    rdfs:label "slurry pump" ;
    rdfs:subClassOf :CentrifugalPump .

:hasImpeller a owl:ObjectProperty .

:ConditionMonitoring a owl:Class ;
    rdfs:label "condition monitoring" .

:RotodynamicPump a owl:Class ;
    rdfs:label "rotodynamic pump" .

:Valve a owl:Class ;
    rdfs:label "valve" .

:requires a owl:ObjectProperty ;
    rdfs:domain :Turbine ;
    rdfs:range :ConditionMonitoring .

:serialNumber a owl:DatatypeProperty ;
    rdfs:domain :Pump ;
    rdfs:range xsd:string .

:Turbine a owl:Class ;
    rdfs:label "turbine" ;
    rdfs:subClassOf :RotatingEquipment .

:Pump a owl:Class ;
    rdfs:label "pump" ;
    rdfs:subClassOf _:N0bf8c62afcad4aca9d9e6dd3140b5d19,
        :RotatingEquipment ;
    owl:disjointWith :Valve .

:RotatingEquipment a owl:Class ;
    rdfs:label "rotating equipment" .

:CentrifugalPump a owl:Class ;
    rdfs:label "centrifugal pump" ;
    rdfs:subClassOf :RotodynamicPump .

